package angelica:plugin@1.0.0;

/// What reaches the plugin's `on-game-event` export: firings of its Lens
/// watches, messages from other plugins, and what happened on its
/// connections. None needs a subscription; each comes in a frame after it
/// happened, after `tick` and the plugin's commands. Called on the main
/// instance only.
interface events {
    use lens.{row};
    use websocket.{socket-opened, socket-message, socket-closed};

    /// One firing of a watched event: the rows of the watch's query.
    record watched {
        /// The handle `lens.watch` returned.
        query: u32,
        rows: list<row>,
    }

    /// A message another plugin sent this one; see the `messages`
    /// interface.
    record plugin-message {
        /// The message's id, which a reply names.
        id: u32,
        /// The sending plugin's id.
        sender: string,
        name: string,
        payload: list<u8>,
        /// The id of this plugin's message it answers.
        in-reply-to: option<u32>,
    }

    /// Firings of a watched event left out since the last delivery.
    record watch-dropped {
        query: u32,
        count: u32,
    }

    variant game-event {
        /// A firing of an event a `lens.watch` watches; needs no
        /// subscription.
        watched(watched),
        watch-dropped(watch-dropped),
        /// A message from another plugin; needs no subscription.
        message(plugin-message),
        /// The host kept at most 256 messages for the plugin between two
        /// frames; this many more were left out.
        messages-dropped(u32),
        /// A connection of the `websocket` interface opened; needs no
        /// subscription.
        socket-opened(socket-opened),
        /// A message on a connection; needs no subscription.
        socket-message(socket-message),
        /// A connection ended; needs no subscription.
        socket-closed(socket-closed),
    }
}
