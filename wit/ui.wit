package angelica:plugin@1.0.0;

/// What a plugin shows: places the host offers, holding parts the host
/// draws.
///
/// Places and parts are data: each has a `kind` and named properties, and
/// the kinds, their properties, and the API version that added each are
/// listed in the plugin API (`docs/formats/plugin-api-v1.md`, "Places and
/// parts"). New kinds and properties are added there without changing
/// these types; a kind or a property never changes its meaning and is never
/// removed. The host checks every place and part against that list: an
/// unknown kind or property, a value of another shape, or a kind newer than
/// the manifest's `plugin.api` faults the plugin.
///
/// Every frame the host calls the guest's `ui` export and shows the places
/// it returns; one that is not returned is not shown. Parts are controlled:
/// they show the value the plugin passes, and a change by the player
/// arrives as an `event` before the next frame. Part ids are unique within
/// a place, and place ids unique per plugin.
///
/// Parts are a flat list: a part of a container kind (`row`, `column`,
/// `grid`, `section`, `table`, `entry`) holds the parts after it up to its
/// `end` part.
interface ui {
    /// The value of a property.
    variant value {
        text(string),
        number(f64),
        integer(s64),
        flag(bool),
        texts(list<string>),
        numbers(list<f64>),
    }

    record property {
        name: string,
        value: value,
    }

    record part {
        kind: string,
        /// For a part that takes input or keeps a state between frames;
        /// empty otherwise.
        id: string,
        properties: list<property>,
    }

    /// A window, a dialog, a panel, a popup, or a menu entry, with the parts
    /// it holds.
    record place {
        kind: string,
        id: string,
        properties: list<property>,
        parts: list<part>,
    }

    /// What the player did, by its kind: `clicked`, `toggled` (a flag),
    /// `edited` (a text), `chosen` (an integer), `set` (a number),
    /// `navigated` (an integer), `closed`, `open-requested`, or
    /// `menu-chosen` (an integer); later API versions may add kinds.
    record event {
        kind: string,
        /// The place's id; empty for `open-requested`.
        place: string,
        /// The part's id; empty for an event of the place itself.
        part: string,
        value: option<value>,
    }
}
