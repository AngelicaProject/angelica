package angelica:plugin@1.0.0;

/// The plugin's private folder. Every plugin has one; no permission is
/// needed. Paths are relative, use `/`, and stay inside the folder: no `..`,
/// empty, or `.` parts, no drive or device names, no trailing dots or
/// spaces. The player can open the folder from the Angelica menu, for
/// example to put a file there for the plugin.
interface storage {
    use types.{error};

    record entry {
        name: string,
        directory: bool,
        /// Size in bytes; zero for a directory.
        size: u64,
    }

    /// The whole file, at most 64 MiB. Larger files are read with
    /// `read-range`.
    read: func(path: string) -> result<list<u8>, error>;

    /// `length` bytes from `offset`, at most 16 MiB; fails when the range
    /// extends past the end of the file.
    read-range: func(path: string, offset: u64, length: u32) -> result<list<u8>, error>;

    /// The file's size in bytes.
    size: func(path: string) -> result<u64, error>;

    /// The entries of a directory, sorted by name. An empty path lists the
    /// root.
    %list: func(path: string) -> result<list<entry>, error>;

    /// Replaces the file with `contents` atomically: a reader sees the old
    /// or the new contents, never a mix. Creates parent directories.
    write: func(path: string, contents: list<u8>) -> result<_, error>;

    /// Appends to the file, creating it and its parent directories.
    append: func(path: string, contents: list<u8>) -> result<_, error>;

    /// Moves a file, replacing the destination atomically.
    rename: func(%from: string, to: string) -> result<_, error>;

    /// Removes a file or an empty directory. Removing a missing path
    /// succeeds.
    remove: func(path: string) -> result<_, error>;
}
