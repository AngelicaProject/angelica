package angelica:plugin@1.0.0;

/// The game's Excel sheets as the game files hold them: the original data,
/// never the text tables of any plugin.
///
/// Values are read by column name. The game map's sheet schemas name the
/// columns of a sheet for each layout the game has had, so a name keeps its
/// meaning when a patch moves the sheet's columns; a sheet whose layout in
/// the running game the map does not know has no names until the map
/// catches up. Read-only; no permission is needed. Reading a sheet the host has not
/// cached decodes all of its pages, which takes milliseconds to a few
/// hundred for the largest sheets; read sheets in a job when that matters.
interface excel {
    use types.{error};

    enum sheet-variant {
        /// One row per row id.
        rows,
        /// Several subrows per row id.
        subrows,
    }

    variant column-kind {
        text,
        boolean,
        int8,
        uint8,
        int16,
        uint16,
        int32,
        uint32,
        float32,
        int64,
        uint64,
        /// One bit, 0 to 7, of a byte.
        packed-boolean(u8),
    }

    /// A column as the running game lays it out. Positions and offsets
    /// change between game builds; they are for text tables, which check
    /// them, never for finding a value.
    record column {
        /// The column's position among the sheet's columns.
        index: u16,
        kind: column-kind,
        /// The byte offset of the column's field in a row.
        offset: u16,
    }

    /// A column the game map names.
    record field {
        name: string,
        kind: column-kind,
        /// The column's position in the running game, for text tables.
        index: u16,
    }

    record sheet-info {
        name: string,
        %variant: sheet-variant,
        columns: list<column>,
        /// The named columns, sorted by name; empty when the game map names
        /// none of the sheet's columns in the running game's layout.
        fields: list<field>,
        /// The game languages the sheet has data for (1 Japanese, 2
        /// English, 3 German, 4 French, 5 and 6 Chinese, 7 Korean, 8
        /// Traditional Chinese); 0 for language-neutral data.
        languages: list<u8>,
        /// Rows, without counting subrows.
        rows: u32,
    }

    variant value {
        /// A game string without its terminator, macros encoded.
        text(list<u8>),
        boolean(bool),
        signed(s64),
        unsigned(u64),
        float(f32),
    }

    record row-key {
        row: u32,
        subrow: u16,
    }

    record sheet-row {
        key: row-key,
        /// One value per requested column, in the order requested.
        values: list<value>,
    }

    /// The names of the game's sheets.
    sheets: func() -> result<list<string>, error>;

    /// A sheet's columns, named columns, languages, and size.
    sheet: func(name: string) -> result<sheet-info, error>;

    /// The values of `columns` in up to `limit` rows (1 to 1024) of the
    /// sheet in `language`, sorted by row and subrow, after `after` or from
    /// the first. A sheet without data in `language` is read in its
    /// language-neutral data; one with neither returns `not-found`. A name
    /// the map does not give the sheet returns `not-found`; a sheet whose
    /// layout the map does not know returns `unavailable`. No columns
    /// returns only the rows' keys.
    rows: func(name: string, language: u8, columns: list<string>, after: option<row-key>, limit: u32) -> result<list<sheet-row>, error>;

    /// The values of `columns` in one row, or `none` when the sheet has no
    /// such row.
    row: func(name: string, language: u8, columns: list<string>, key: row-key) -> result<option<sheet-row>, error>;

    /// The text of the text column `column` in one row as the game shows
    /// it now: the text a rule of any plugin at `sheet_text` puts there,
    /// such as a translation, or the game's own text when no rule holds
    /// for the cell. `none` when the sheet has no such row. `row` and `rows`
    /// always return the game's own text; a plugin asks for the shown
    /// text only to show it to the player, never to find something by it.
    shown: func(name: string, language: u8, column: string, key: row-key) -> result<option<list<u8>>, error>;
}
