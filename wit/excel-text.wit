package angelica:plugin@1.0.0;

/// Replacement text for cells of the game's Excel sheets.
///
/// A plugin writes a text table (`docs/formats/text-table-v1.md`; the SDK
/// has a writer) to its storage and activates it. From then on, whenever the
/// game builds a row of a listed sheet, the host replaces the listed cells
/// before anything else in the game sees the row. A cell is replaced only
/// when the sheet's text columns equal the table's layout for it and the
/// game's original text matches the cell's guard; otherwise the game's text
/// stays. Rows the game built earlier keep the text they had.
///
/// The host reads the table from the plugin's storage without copying it
/// and validates it completely on activation. Requires `excel.text`.
/// Called from the main instance only.
interface excel-text {
    use types.{error};

    record table-info {
        sheets: u32,
        cells: u64,
    }

    record table-status {
        /// Rows the game built with at least one replaced cell.
        rows-changed: u64,
        cells-replaced: u64,
        /// Cells whose original text did not match their guard.
        guard-mismatches: u64,
        /// Rows of a listed sheet whose buffer did not have the expected
        /// layout; they keep the game's text.
        rows-refused: u64,
        /// Listed sheets the game has loaded that do not match the table.
        sheets-mismatched: list<sheet-mismatch>,
    }

    record sheet-mismatch {
        sheet: string,
        reason: mismatch,
    }

    enum mismatch {
        /// The sheet's text columns differ from the table's layout.
        layout,
        /// The sheet has subrows and the table says it has none, or the
        /// reverse.
        %variant,
        /// The sheet is in another language than the table's source.
        language,
    }

    /// Activates the table at `path` under `name`, replacing a table the
    /// plugin activated under the same name. When tables of several plugins
    /// list a cell, the one with the higher `priority` is tried first, then
    /// tables by plugin id and name; the first whose guard matches applies.
    /// Activation is refused, and the previous table stays, when the file
    /// is not a valid text table or the game build lacks the entries the
    /// row hook needs.
    activate: func(name: string, path: string, priority: s32) -> result<table-info, error>;

    /// Deactivates a table. Rows the game builds afterwards keep its text.
    deactivate: func(name: string) -> result<_, error>;

    /// Counters since the table was activated.
    status: func(name: string) -> result<table-status, error>;
}
