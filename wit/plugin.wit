package angelica:plugin@1.0.0;

/// What every plugin exports. The host calls the main instance on the game's
/// main thread and `run-job` in job instances on host threads.
interface guest {
    use ui.{place, event};
    use commands.{invocation};
    use events.{game-event};

    /// Called once when the plugin is enabled. An error disables it and is
    /// shown in the Angelica menu.
    start: func() -> result<_, string>;

    /// Called once before the plugin is disabled, also at game exit. Rules,
    /// watches, and changes the plugin made are removed afterwards in any
    /// case.
    stop: func();

    /// Called every frame with the seconds since the previous call.
    tick: func(elapsed: f64) -> result<_, string>;

    /// The plugin's windows, each followed by its dialog, and panels for this frame.
    ui: func() -> list<place>;

    /// A player action in one of the plugin's windows or the Angelica menu.
    ui-event: func(event: event);

    /// A command of the plugin the player ran; see the `commands`
    /// interface. Called after `tick` of the frame that follows. An error
    /// is printed in the chat log as the plugin's message.
    command: func(invocation: invocation) -> result<_, string>;

    /// A firing of one of the plugin's watches, a message from another
    /// plugin, or what happened on its connections; see the `events`
    /// interface.
    /// Called after the plugin's commands of the frame.
    on-game-event: func(event: game-event);

    /// Runs a job that `jobs.start` started; see the `jobs` interface.
    run-job: func(name: string, input: list<u8>) -> result<list<u8>, string>;
}

world plugin {
    import runtime;
    import storage;
    import jobs;
    import game-files;
    import excel;
    import file-replacements;
    import commands;
    import chat;
    import http;
    import lens;
    import events;
    import draw;
    import messages;
    import clipboard;
    import links;
    import notifications;
    import sound;
    import websocket;
    import intercepts;
    import memory;
    import calls;
    import gpu;
    import look;
    import game-map;
    export guest;
}

/// A plugin that may also intercept, make thunks, and take input on its
/// surfaces: what the SDK builds. A component of the `plugin` world
/// without `handler`, `thunk-handler`, and `surface-handler` runs as
/// before.
world intercepting {
    include plugin;
    export handler;
    export thunk-handler;
    export surface-handler;
}

/// What the host calls in an intercept instance.
world intercept-handler {
    export handler;
}

/// What the host calls in an intercept instance for a thunk.
world thunk-called {
    export thunk-handler;
}

/// What the host calls in a main instance for input on its surfaces.
world surface-input {
    export surface-handler;
}
