package angelica:plugin@1.0.0;

/// What every plugin exports. The host calls the main instance on the game's
/// main thread and `run-job` in job instances on host threads.
interface guest {
    use ui.{window, event};
    use commands.{invocation};
    use events.{game-event};

    /// Called once when the plugin is enabled. An error disables it and is
    /// shown in the Angelica menu.
    start: func() -> result<_, string>;

    /// Called once before the plugin is disabled, also at game exit. Tables,
    /// letters, and rules for the game's windows the plugin activated are
    /// removed afterwards in any case.
    stop: func();

    /// Called every frame with the seconds since the previous call.
    tick: func(elapsed: f64) -> result<_, string>;

    /// The plugin's windows for this frame.
    ui: func() -> list<window>;

    /// A player action in one of the plugin's windows or the Angelica menu.
    ui-event: func(event: event);

    /// A command of the plugin the player ran; see the `commands`
    /// interface. Called after `tick` of the frame that follows. An error
    /// is printed in the chat log as the plugin's message.
    command: func(invocation: invocation) -> result<_, string>;

    /// A firing of one of the plugin's watches, a message from another
    /// plugin, or what happened on its connections; see the `events`
    /// interface.
    /// Called after the plugin's commands of the frame.
    on-game-event: func(event: game-event);

    /// Runs a job that `jobs.start` started; see the `jobs` interface.
    run-job: func(name: string, input: list<u8>) -> result<list<u8>, string>;
}

world plugin {
    import runtime;
    import storage;
    import jobs;
    import game-files;
    import excel;
    import excel-text;
    import file-replacements;
    import text-case;
    import commands;
    import chat;
    import http;
    import lens;
    import events;
    import game-ui;
    import draw;
    import messages;
    import clipboard;
    import notifications;
    import sound;
    import websocket;
    export guest;
}
