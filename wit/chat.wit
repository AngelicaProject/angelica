package angelica:plugin@1.0.0;

/// Messages in the player's chat log.
///
/// A message is a list of spans of plain text, each in a tone. The host
/// renders the tones with the colors of the game's interface theme and
/// starts every message with the plugin's name in a color plugins cannot
/// use, so a plugin's message never looks like the game's or another
/// plugin's. Messages appear in the Echo channel. Requires `chat.print`.
/// Called from the main instance only.
interface chat {
    use types.{error};

    enum tone {
        normal,
        /// Draws the eye: names, values, commands.
        accent,
        /// Secondary detail.
        muted,
        good,
        warning,
        bad,
    }

    record span {
        /// Plain text; a line break starts a new line. No other control
        /// characters.
        text: string,
        tone: tone,
        italic: bool,
    }

    /// Prints a message. At most 64 spans and 2000 bytes of text; a plugin
    /// prints at most 20 messages in any second. Returns `unavailable`
    /// before the game's chat log exists, during the game's start.
    print: func(message: list<span>) -> result<_, error>;

    /// An item of the game's `Item` sheet, linked as the game links an
    /// item in the chat log: the link's arrow and the item's name in the
    /// color of its rarity, which the player clicks for the item's
    /// tooltip. The host takes the name and the rarity from the sheet, so
    /// a link always names the item it shows.
    record item-link {
        /// The item's row of the `Item` sheet.
        item: u32,
        /// The item's high-quality version, marked as the game marks it.
        hq: bool,
        /// The language of the name by the game's number, as `excel` takes
        /// it; the name is the one `excel.shown` gives.
        language: u8,
    }

    /// A part of a message: text in a tone, or an item link.
    variant piece {
        span(span),
        item(item-link),
    }

    /// Prints a message as `print` does, with up to 8 item links among its
    /// spans. An item the sheet does not have, or without a name, is
    /// `not-found`; `unavailable` also when the running game map does not
    /// name the sheet's `name` and `rarity` columns.
    print-pieces: func(message: list<piece>) -> result<_, error>;
}
